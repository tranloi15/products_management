extends ../../layouts/default.pug
include ../../mixins/filter-status.pug
include ../../mixins/sort-category.pug
include ../../mixins/form-change-multi.pug
include ../../mixins/table-tree-post.pug

block main
  if(role.permissions.includes("posts-category_view"))
    h1 #{pageTitle}

    .card.mb-3
      .card-header Bộ lọc và Tìm kiếm
      .card-body
        .row
          .col-6
            +filter-status(filterStatus)
          .col-4
            +sort()

    .card.mb-3
      .card-header Danh sách
      .card-body
        .row
          .col-8
            +form-change-multi(`${prefixAdmin}/posts-category/change-multi?_method=PATCH`)
          .col-4
            if(role.permissions.includes("posts-category_create"))
              a(
                href=`${prefixAdmin}/posts-category/create`
                class="btn btn-outline-success float-right"
              ) + Thêm mới

        table(
          class="table table-hover table-sm"
          checkbox-multi
        )
          thead
            tr
              th
                input(type="checkbox" name="checkall")
              th STT
              th Hình ảnh
              th Tiêu đề
              th Vị trí
              th Trạng thái
              th Người tạo
              th Người cập nhật
              th Hành động

          tbody
            if (records && records.length > 0)
              +table-tree-post(records)
            else
              tr
                td(colspan="9" class="text-center") Chưa có danh mục nào.

    form(
      action=""
      method="POST"
      id="form-delete-item"
      data-path=`${prefixAdmin}/posts-category/delete`
    )
    script(src="/admin/js/post-category.js")
  else
    h2 Bạn không có quyền truy cập tính năng này!