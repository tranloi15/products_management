extends ../../layouts/default.pug
include ../../mixins/alert.pug
include ../../mixins/moment.pug

block main
  +alert-success(5000)
  +alert-error(5000)

  if(role.permissions.includes("roles_edit"))
    h1(class="mb-4") #{pageTitle}

    form(
      action=`${prefixAdmin}/roles/edit/${data.id}?_method=PATCH`
      method="POST"
    )
      div(class="form-group")
        label(for="title") Tiêu đề
        input(
          type="text"
          class="form-control"
          id="title"
          name="title"
          required
          value=data.title
        )

      div(class="form-group")
        label(for="desc") Mô tả
        textarea(
          class="form-control textarea-mce"
          id="desc"
          name="description"
          rows="5"
        ) !{data.description}

      //- Khối hiển thị thông tin người tạo và người sửa
      div(class="card mb-4 bg-light")
        div(class="card-body py-2")
          if(data.accountFullName)
            p(class="mb-1 text-muted")
              strong Người tạo: 
              | #{data.accountFullName} 
              if(data.createdBy && data.createdBy.createdAt)
                | - (
                +formatDateTime(data.createdBy.createdAt)
                | )

          - const updatedBy = data.updatedBy?.slice(-1)[0];
          if(updatedBy && updatedBy.accountFullName)
            p(class="mb-0 text-muted")
              strong Cập nhật lần cuối bởi: 
              | #{updatedBy.accountFullName} - (
              +formatDateTime(updatedBy.updatedAt)
              | )

      div(class="form-group")
        button(
          type="submit"
          class="btn btn-primary"
        ) Cập nhật
  else
    h2 Bạn không có quyền truy cập tính năng này!