mixin product-item(item)
  .col-4.mb-3
    .product-item
      .inner-image
        img(
          src=(item.thumbnail && item.thumbnail !== '/uploads/undefined' ? item.thumbnail : 'https://placehold.co/300x200?text=No+Image')
          alt=item.title
          onerror="this.onerror=null;this.src='https://placehold.co/300x200?text=No+Image';"
        )
      .inner-content
        h3.inner-title
          a(href=`/products/${item.slug}`) #{item.title}
        .inner-price-new #{item.priceNew}$
        .inner-price-old #{item.price}$
        .inner-discount -#{item.discountPercentage}%