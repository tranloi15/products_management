extends ../../layouts/default.pug
include ../../mixins/box-head.pug
include ../../mixins/post-item.pug

block main
  .container.my-3
    .row
      .col-12
        +box-head(pageTitle)

    .row
      if (posts.length > 0)
        each item in posts
          +post-item(item)
      else
        .col-12
          p Chưa có bài viết nào.