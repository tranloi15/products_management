extends ../../layouts/default.pug
include ../../mixins/box-head.pug

block main
  .container.my-3
    .row
      .col-8.mx-auto
        +box-head(pageTitle)

        form(
          action="/user/password/reset"
          method="POST"
        )
          div(class="form-group")
            label(for="password") Mật khẩu mới
            input(
              type="password"
              class="form-control"
              id="password"
              name="password"
              minlength="8"
              required
            )
            small(class="form-text text-muted")
              | Tối thiểu 8 ký tự, bao gồm chữ hoa, chữ thường, số và ký tự đặc biệt (@$!%*?&).

          div(class="form-group")
            label(for="confirmPassword") Xác nhận mật khẩu mới
            input(
              type="password"
              class="form-control"
              id="confirmPassword"
              name="confirmPassword"
              minlength="8"
              required
            )

          div(class="form-group")
            button(
              type="submit"
              class="btn btn-primary btn-block"
            ) Đổi mật khẩu