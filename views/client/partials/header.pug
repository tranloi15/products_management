include ../mixins/sub-menu.pug

header.header
  .container
    .row.align-items-center
      //- Logo
      .col-2
        .inner-logo
          a(href="/")
            img(src="/images/logo.jpeg", alt="Logo")

      //- Menu
      .col-4
        .inner-menu
          ul
            li
              a(href="/") Trang chủ
            li(class="sub-menu")
              - const pathProduct = "/products";
              a(href=pathProduct) Sản phẩm
              if (layoutCategoryProducts)
                +sub-menu(layoutCategoryProducts, pathProduct)
            li(class="sub-menu")
              - const pathPost = "/posts";
              a(href=pathPost) Bài viết
              if (layoutCategoryPosts)
                +sub-menu(layoutCategoryPosts, pathPost)

      //- Tìm kiếm
      .col-3
        form(action="/search" method="GET")
          div(class="form-group d-flex mb-0")
            input(
              type="text"
              placeholder="Nhập từ khóa..."
              class="form-control"
              name="keyword"
              value=keyword
            )
            button(
              type="submit"
              class="btn btn-primary ml-2"
            ) Tìm

      //- Cụm người dùng & Giỏ hàng
      .col-3
        .inner-actions.d-flex.align-items-center.justify-content-end
          a(href="/cart" class="btn btn-outline-success mr-2")
            | Giỏ hàng (#{miniCart ? miniCart.totalQuantity : 0})
          ul.d-flex.align-items-center.list-unstyled.mb-0
            if (user)
              li.mr-2
                a(href="/user/info" class="btn btn-sm btn-light") #{user.fullName}
              li
                a(href="/user/logout" class="btn btn-sm btn-outline-danger") Đăng xuất
            else
              li.mr-1
                a(href="/user/login" class="btn btn-sm btn-primary") Đăng nhập
              li
                a(href="/user/register" class="btn btn-sm btn-outline-primary") Đăng ký