{
    "version": 2,
    "builds": [
        {
            "src": "index.js",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/(.*\\.(css|js|png|jpg|jpeg|svg|ico|gif|webp|woff|woff2|ttf))",
            "dest": "/public/$1"
        },
        {
            "src": "/(.*)",
            "dest": "index.js"
        }
    ]
}